# Copy to .env and fill in (or run: python -m glasswall.make_env from python/).
# .env is gitignored. Never commit real values.

POSTGRES_PASSWORD=change-me

# Setup connection: superuser locally, the Neon owner user when deployed
DATABASE_URL_SETUP=postgresql://postgres:change-me@127.0.0.1:5432/glasswall

# Passwords for the roles created by sql/01_roles.sql
GW_ADMIN_PW=change-me
GW_WALL_PW=change-me
GW_OPEN_PW=change-me
GW_WRITER_PW=change-me

# Tokenization salt (secret; lives only in vault.salt and here)
GW_SALT=change-me

# Host/port/db used to build the per-role connection URLs
GW_DB_HOST=127.0.0.1
GW_DB_PORT=5432
GW_DB_NAME=glasswall
GW_DB_SSLMODE=disable
